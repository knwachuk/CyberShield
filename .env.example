# Copy to ".env" and fill in. The .env file is loaded automatically and should
# never be committed (it is covered by .gitignore).

# Twitter/X API v2 bearer token. Leave unset to run against bundled sample data.
CYBERSHIELD_TWITTER_BEARER_TOKEN=

# Analyzer mode: "lite" (lexicon + VADER, default) or "full" (adds transformers).
CYBERSHIELD_ANALYZER_MODE=lite

# Optional override for the sample/fixture data directory.
# CYBERSHIELD_DATA_DIR=/absolute/path/to/data
